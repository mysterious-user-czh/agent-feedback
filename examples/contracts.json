[
  {
    "skill": "microsoft-office",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "word_to_pdf", "patterns": ["转(?:成|为)?\\s*PDF", "保存成\\s*PDF", "导出为\\s*PDF"]}
      ],
      "forbidden": [
        {"id": "pure_excel", "patterns": ["^[^Word文档]*(?:xlsx|Excel).*(?:公式|透视表)"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 3, "allowed_tools": ["skill_view", "terminal", "python"]},
    "output": {"artifact_extension": ".pdf"}
  },
  {
    "skill": "docx-editing",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "body_editing", "patterns": ["修改正文", "公式.*重新编", "跨页.*表格"]}
      ],
      "forbidden": [
        {"id": "image_compression", "patterns": ["截图.*压", "图片.*压缩"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 2}
  },
  {
    "skill": "docx",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "word_review", "patterns": ["(?:Word|docx).*(?:修订|批注)", "(?:修订|批注).*(?:Word|docx)"]},
        {"id": "word_template", "patterns": ["(?:Word|docx).*模板.*(?:填|占位)", "\\{\\{[^}]+\\}\\}.*(?:填|模板)"]},
        {"id": "word_corruption", "patterns": ["(?:Word|docx).*(?:损坏|打不开|无法打开)"]}
      ],
      "forbidden": [
        {"id": "legacy_doc", "patterns": ["(?:旧版|老格式|legacy).*\\.doc\\b", "\\.doc\\b.*(?:旧版|老格式|legacy)"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 3}
  },
  {
    "skill": "hermes-agent",
    "version": 1,
