    "execution": {"read_first": true, "max_selections": 3}
  },
  {
    "skill": "hyperframes-cli",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "cli_failure", "patterns": ["npx hyperframes.*(?:报错|失败|错误)", "HyperFrames.*(?:CLI|命令).*(?:报错|失败|怎么|如何)"]}
      ],
      "forbidden": [
        {"id": "plain_ffmpeg", "patterns": ["(?:只用|仅用)(?:普通)?\\s*ffmpeg.*(?:剪辑|转码|压缩)"]}
