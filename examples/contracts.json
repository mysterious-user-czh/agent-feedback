      ],
      "forbidden": [
        {"id": "proxy_subscription", "patterns": ["(?:代理机场|机场订阅|Clash|v2rayN).*(?:节点|订阅|诊断|上不了网)"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 2}
  },
  {
    "skill": "hyperframes",
    "version": 1,
    "trigger": {
