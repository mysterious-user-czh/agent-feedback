      "forbidden": [
        {"id": "not_gateway", "patterns": ["(?:gateway|网关).*(?:离线|掉线|不回复)"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 2}
  },
  {
    "skill": "hermes-gateway-ops",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "gateway_health", "patterns": ["Hermes.*(?:gateway|网关).*(?:离线|掉线|警告|不回复)", "微信.*(?:机器人|bot).*(?:不回复|离线)"]}
      ],
      "forbidden": [
        {"id": "not_desktop_ui", "patterns": ["(?:桌面插件|desktop plugin).*(?:不显示|没出现|未出现)"]}
      ]
    },
    "execution": {"read_first": true, "max_selections": 2}
  },
  {
    "skill": "hermes-agent-skill-authoring",
    "version": 1,
    "trigger": {
      "required": [
        {"id": "in_repo_skill", "patterns": ["(?:仓库|repo|分支|commit).*SKILL\\.md", "SKILL\\.md.*(?:仓库|repo|分支|commit)"]}
      ],
      "forbidden": [
        {"id": "personal_skill_only", "patterns": ["(?:个人技能|本地技能|~/.hermes/skills).*(?:创建|新建|添加)"]}
